{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#12.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#12.0.0",
    ":semanticCommits",
  ],
  schedule: ["every weekend"],
  ignorePaths: ["**/*.sops.*", "**/*.md"],
  packageRules: [
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["ghcr.io/siderolabs/installer", "siderolabs/talos", "talosctl"],
      minimumGroupSize: 3,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Mise Tools",
      matchManagers: ["mise"],
      automerge: true,
      automergeType: "branch",
      matchUpdateTypes: ["minor", "patch"],
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "beets 2.14.x requires Python <3.15; keep the beets CronJob image on 3.14 (3.15 broke pip install in #885)",
      matchDatasources: ["docker"],
      matchPackageNames: ["python"],
      matchFileNames: ["kubernetes/apps/media/beets/app/cronjob-beets-tag.yaml"],
      allowedVersions: "<3.15",
    },
    {
      description: "MariaDB 13.0 is a rolling release (EOL 2026-12-31, no bug-fix releases); stay on the 12.3 LTS line (supported to 2029-06) until 13.3 LTS ships (~May 2027)",
      matchDatasources: ["docker"],
      matchPackageNames: ["mariadb"],
      matchFileNames: ["kubernetes/apps/media/booklore/app/mariadb-deployment.yaml"],
      allowedVersions: "<13",
    },
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
    {
      matchDatasources: ["docker"],
      addLabels: ["renovate/container"],
    },
    {
      matchDatasources: ["helm"],
      addLabels: ["renovate/helm"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["renovate/github-action"],
    },
    {
      matchDatasources: ["github-releases"],
      addLabels: ["renovate/github-release"],
    },
    {
      description: "Disable the talosFactory preset's talosVersion detection: talos/talenv.yaml is already tracked via the annotated manager against ghcr.io/siderolabs/installer, and having both fire on the same line causes competing updates",
      matchDatasources: ["custom.talos-factory"],
      enabled: false,
    },
  ],
}
